{
  "schemaVersion": 1,
  "worldId": "continuation-workshop",
  "title": "社区工坊：从报修到检查开放，再到现场核实",
  "worldTime": {
    "unit": "year",
    "year": 100
  },
  "places": [
    {
      "id": "service-desk",
      "name": "办理处"
    },
    {
      "id": "workshop",
      "name": "目标现场"
    }
  ],
  "routes": [
    {
      "from": "service-desk",
      "to": "workshop"
    },
    {
      "from": "workshop",
      "to": "service-desk"
    }
  ],
  "characters": [
    {
      "id": "resident",
      "name": "求助者",
      "place": "service-desk",
      "publicProfile": {
        "occupation": "社区居民"
      },
      "privateProfile": {
        "knownRoutes": [
          {
            "from": "service-desk",
            "to": "workshop",
            "evidenceFactId": "known-route"
          }
        ],
        "responsePolicy": {
          "goalId": "submit-request",
          "goal": "先提出有记录的申请，再核实结果",
          "rules": [
            {
              "id": "submit-on-location",
              "priority": 10,
              "when": {
                "factId": "equipment-location",
                "equals": "workshop"
              },
              "conditions": [],
              "stateChanges": [
                {
                  "factId": "inspection-request",
                  "expectedValue": false,
                  "value": true
                }
              ],
              "shareFactIds": [
                "inspection-request"
              ],
              "description": "按本人收到的消息提出决定，合法性由世界法则裁决"
            }
          ]
        }
      }
    },
    {
      "id": "steward",
      "name": "办理者",
      "place": "service-desk",
      "publicProfile": {
        "occupation": "工坊管理员"
      },
      "privateProfile": {
        "responsePolicy": {
          "goalId": "process-request",
          "goal": "收到申请后在职责范围内办理并告知结果",
          "rules": [
            {
              "id": "process-known-request",
              "priority": 10,
              "when": {
                "factId": "inspection-request",
                "equals": true
              },
              "conditions": [],
              "stateChanges": [
                {
                  "factId": "equipment-available",
                  "expectedValue": false,
                  "value": true
                },
                {
                  "factId": "inspection-complete",
                  "expectedValue": false,
                  "value": true
                }
              ],
              "shareFactIds": [
                "equipment-available"
              ],
              "description": "按本人收到的消息提出决定，合法性由世界法则裁决"
            }
          ]
        }
      }
    },
    {
      "id": "volunteer",
      "name": "未参与者",
      "place": "workshop",
      "publicProfile": {},
      "privateProfile": {
        "concern": "没有接触这段办理过程"
      }
    }
  ],
  "facts": [
    {
      "id": "equipment-location",
      "subject": "service",
      "predicate": "located-at",
      "value": "workshop",
      "mode": "fixed",
      "knownBy": [
        "steward"
      ],
      "observableAt": [
        "service-desk"
      ]
    },
    {
      "id": "known-route",
      "subject": "service-desk",
      "predicate": "route-open",
      "value": true,
      "mode": "fixed",
      "knownBy": [
        "resident",
        "steward"
      ]
    },
    {
      "id": "service-role",
      "subject": "steward",
      "predicate": "service-role",
      "value": "steward",
      "mode": "fixed",
      "knownBy": [
        "steward"
      ]
    },
    {
      "id": "inspection-request",
      "subject": "resident",
      "predicate": "requested",
      "value": false,
      "mode": "state",
      "knownBy": [
        "resident"
      ],
      "observableAt": [
        "service-desk"
      ]
    },
    {
      "id": "equipment-available",
      "subject": "service",
      "predicate": "result",
      "value": false,
      "mode": "state",
      "knownBy": [
        "steward"
      ],
      "observableAt": [
        "service-desk",
        "workshop"
      ]
    },
    {
      "id": "inspection-complete",
      "subject": "service",
      "predicate": "record-complete",
      "value": false,
      "mode": "state",
      "knownBy": [
        "steward"
      ],
      "observableAt": [
        "service-desk",
        "workshop"
      ]
    },
    {
      "id": "resource-quantity",
      "subject": "service",
      "predicate": "quantity",
      "value": 4,
      "mode": "state",
      "knownBy": [
        "steward"
      ],
      "observableAt": [
        "workshop"
      ]
    },
    {
      "id": "further-permission",
      "subject": "service",
      "predicate": "public-use-permission",
      "value": false,
      "mode": "state",
      "knownBy": [
        "steward"
      ],
      "observableAt": [
        "workshop"
      ]
    },
    {
      "id": "private-origin",
      "subject": "service",
      "predicate": "hidden-history",
      "value": "作者保留的未揭示资料",
      "mode": "fixed",
      "knownBy": []
    }
  ],
  "laws": [
    {
      "id": "request-writer",
      "kind": "writeAccess",
      "factId": "inspection-request",
      "actors": [
        "resident"
      ]
    },
    {
      "id": "result-writer",
      "kind": "writeAccess",
      "factId": "equipment-available",
      "actors": [
        "steward"
      ]
    },
    {
      "id": "record-writer",
      "kind": "writeAccess",
      "factId": "inspection-complete",
      "actors": [
        "steward"
      ]
    },
    {
      "id": "permission-writer",
      "kind": "writeAccess",
      "factId": "further-permission",
      "actors": []
    },
    {
      "id": "result-domain",
      "kind": "oneOf",
      "factId": "equipment-available",
      "values": [
        false,
        true
      ]
    },
    {
      "id": "resource-positive",
      "kind": "range",
      "factId": "resource-quantity",
      "min": 0
    },
    {
      "id": "result-requires-request-and-role",
      "kind": "changeRequires",
      "factId": "equipment-available",
      "whenEquals": true,
      "conditions": [
        {
          "factId": "inspection-request",
          "equals": true
        }
      ],
      "actorCondition": {
        "predicate": "service-role",
        "equals": "steward"
      }
    }
  ]
}
